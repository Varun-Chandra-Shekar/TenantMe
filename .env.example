# LLM provider — placeholder only, never a real key in this file
ANTHROPIC_API_KEY=your-key-here

# Model names
LLM_MODEL_DEV=claude-haiku-4-5-20251001
LLM_MODEL_JUDGE=claude-opus-4-7

# Local models — run on your machine, no key needed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Database — must match docker-compose.yml (note port 5433)
DATABASE_URL=postgresql://tenantmate:tenantmate@localhost:5433/tenantmate
